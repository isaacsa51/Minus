{
  "name": "minus-promo-es",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render MinusPromoEs ../output/minus-promo-es.render.mp4",
    "finalize": "node scripts/mux.mjs ../output/minus-promo-es.render.mp4 ../output/minus-promo-es.mp4",
    "build": "npm run render && npm run finalize",
    "remux-audio": "node scripts/mux.mjs ../output/minus-promo-es.mp4 ../output/minus-promo-es.mp4",
    "still": "remotion still MinusPromoEs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
