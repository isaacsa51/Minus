<resources>
    <string name="app_name">Minus</string>
    <string name="tutorial_numpad_title">नंपैड</string>
    <string name="tutorial_numpad_description">अपनी खर्च की गई रकम डालें और सेव करने के लिए हरे रंग के चेक मार्क पर टैप करें। कैलकुलेट करने के लिए नंपैड पर ऊपर की ओर स्वाइप करें।</string>
    <string name="tutorial_comment_title">कैटेगरी जोड़ें</string>
    <string name="tutorial_comment_description">यह याद रखने के लिए कि खर्च किस चीज़ के लिए किया गया था, एक कैटेगरी या छोटा नोट जोड़ें।</string>
    <string name="tutorial_budget_pill_title">बजट की प्रगति</string>
    <string name="tutorial_budget_pill_description">रोज़ाना, हफ़्तेवार और महीने के बजट व्यू के बीच स्विच करने या समय-सीमा सेट-अप को एडिट करने के लिए टैप करें।</string>
    <string name="tutorial_settings_title">सेटिंग्स</string>
    <string name="tutorial_settings_description">फ़ीचर चालू करने, होम-स्क्रीन विजेट सेट अप करने या इस ट्यूटोरियल को रीसेट करने के लिए सेटिंग्स खोलें।</string>
    <string name="tutorial_recurrent_title">बार-बार होने वाले पेमेंट</string>
    <string name="tutorial_recurrent_description">इस खर्च को बार-बार होने वाले पेमेंट (हफ़्ते में एक बार, हर दो हफ़्ते में, या महीने में एक बार) के तौर पर मार्क करने के लिए यहाँ टैप करें। ऐप आपको इसे तय समय पर रिकॉर्ड करने के लिए याद दिलाएगा।</string>
    <string name="tutorial_analytics_title">अपना एनालिटिक्स देखें</string>
    <string name="tutorial_analytics_description">यह देखने के लिए एनालिटिक्स खोलें कि समय के साथ, कैटेगरी के हिसाब से और आपके बजट लक्ष्यों के मुकाबले आपका खर्च कैसे हुआ है।</string>
    <string name="tutorial_privacy_title">प्राइवेसी मोड</string>
    <string name="tutorial_privacy_description">स्क्रीन पर मौजूद सभी रकम को धुंधला करने के लिए लगभग एक सेकंड के लिए फ़ोन के ऊपरी हिस्से (जहाँ फ्रंट कैमरा होता है) को अपने हाथ से ढकें। इसे बंद करने के लिए फिर से ढकें।</string>
    <string name="tutorial_calc_title">चल रहा बजट</string>
    <string name="tutorial_calc_description">इस समय-सीमा के लिए अपने बचे हुए बजट को बढ़ाने या घटाने के लिए शुरुआत में + या - का इस्तेमाल करें।</string>
    <string name="tutorial_credit_toggle_title">क्रेडिट कार्ड से पेमेंट</string>
    <string name="tutorial_credit_toggle_description">यह मार्क करने के लिए कि यह खर्च क्रेडिट कार्ड से किया गया था, यहाँ टैप करें। इसे आपके एनालिटिक्स में अलग से ट्रैक किया जाएगा।</string>
