<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="APR"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:columnCount="7"
        android:rowCount="6">

        <View android:layout_width="14dp" android:layout_height="14dp" android:layout_margin="1dp" android:background="#40FFFFFF" />
        <View android:layout_width="14dp" android:layout_height="14dp" android:layout_margin="1dp" android:background="#6681C784" />
        <View android:layout_width="14dp" android:layout_height="14dp" android:layout_margin="1dp" android:background="#40FFFFFF" />
        <View android:layout_width="14dp" android:layout_height="14dp" android:layout_margin="1dp" android:background="#80FFB74D" />
        <View android:layout_width="14dp" android:layout_height="14dp" android:layout_margin="1dp" android:background="#40FFFFFF" />
        <View android:layout_width="14dp" android:layout_height="14dp" android:layout_margin="1dp" android:background="#99FFB74D" />
        <View android:layout_width="14dp" android:layout_height="14dp" android:layout_margin="1dp" android:background="#40FFFFFF" />

    </GridLayout>

</LinearLayout>