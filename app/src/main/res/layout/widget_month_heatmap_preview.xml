                android:layout_height="18dp"
                android:layout_margin="1dp" />

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_margin="1dp"
                android:background="@color/widget_heatmap_good_1"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
