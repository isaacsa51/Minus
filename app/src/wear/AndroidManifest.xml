<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <meta-data
            android:name="com.google.android.gms.wearable.capabilities"
            android:resource="@array/android_wear_capabilities" />

        <service
            android:name=".wearsync.PhoneWearListenerService"
            android:enabled="true"
            android:exported="true"
            android:permission="com.google.android.gms.permission.BIND_LISTENER">
            <!--
                Filtered MESSAGE_RECEIVED registration (not the legacy catch-all
                BIND_LISTENER action, which is unreliable for background delivery
                on current Play Services). Covers /expense/* (add, snapshot) and
                /budget/* (state request) from the watch.
            -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/expense" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/budget" />
            </intent-filter>
        </service>
    </application>
</manifest>
