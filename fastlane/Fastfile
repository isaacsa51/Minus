default_platform(:android)

platform :android do
  desc "Genera el APK Release firmado y crea un Release en GitHub"
  lane :publish_github do
    version_tag = ENV.fetch("VERSION_TAG")

    gradle(
      task: "assemble",
      build_type: "Release"
    )

    sh(
      "gh",
      "release",
      "create",
      version_tag,
      "app/build/outputs/apk/release/app-release.apk",
      "--repo",
      ENV.fetch("GITHUB_REPOSITORY", "isaacsa51/Minus"),
      "--title",
      "Minus #{version_tag}",
      "--notes",
      "Nuevo lanzamiento de Minus."
    )
  end
end
