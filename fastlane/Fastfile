default_platform(:android)

platform :android do
  desc "Genera el APK Release firmado y crea un Release en GitHub"
  lane :publish_github do
    version_tag = ENV.fetch("VERSION_TAG")

    gradle(
      task: "assemble",
      build_type: "Release"
    )

    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
    UI.user_error!("No se encontró el APK generado por Gradle") unless apk_path && File.exist?(apk_path)

    sh(
      "gh",
      "release",
      "create",
      version_tag,
      apk_path,
      "--repo",
      ENV.fetch("GITHUB_REPOSITORY", "isaacsa51/Minus"),
      "--title",
      "Minus #{version_tag}",
      "--notes",
      "Nuevo lanzamiento de Minus."
    )
  end
end
