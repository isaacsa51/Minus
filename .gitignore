# Generated changelog (regenerated by :app:generateAppChangelogJson on every preBuild
# from fastlane/metadata/android/en-US/changelogs/*.txt - single source of truth)
app/src/main/assets/changelog.json
/build

# Fastlane transient report (regenerated on every `bundle exec fastlane`)
fastlane/report.xml

# Changelog curation backups written by :prep_release when a curated
# .txt already exists. Gitignored — restore manually with `mv <bak> .txt`
# if you want to recover a previous curation.
fastlane/metadata/**/changelogs/*.bak.*